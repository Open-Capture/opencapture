/target
**/target/
# Build directories that **/target/ misses because of their name.
**/*-target/
node_modules/
# Scoped to the extension's own Vite build output, not bare "dist/" — that
# would also match apps/extension/vendor/{sdk,ui}/dist, which is a
# pre-built copy of @openapps/sdk and @openapps/ui committed so `npm ci &&
# npm run build` works without touching those packages at all. Their real
# source lives in apps/extension/vendor-src/ (committed) — see
# apps/extension/scripts/build-vendor.sh, which rebuilds vendor-src/ and
# refreshes vendor/{sdk,ui}/dist from it. Only vendor-src's own dist/ is
# generated-and-ignored; the vendor/ copy it gets copied into is not.
apps/extension/dist/
apps/extension/dist-firefox/
apps/extension/web-ext-artifacts/
apps/extension/vendor-src/sdk/dist/
apps/extension/vendor-src/ui/dist/
# wasm-bindgen output — regenerated by apps/extension/scripts/build-wasm.sh
apps/extension/src/wasm-gen/
# Playwright artifacts
playwright-report/
test-results/

# Private half of the keypair pinning the Chrome extension ID across
# reloads/machines (see apps/extension/public/manifest.json's "key" field)
# — whoever holds this can publish updates as this exact extension.
apps/extension/extension-key.pem

.DS_Store
*.swp

# Local MCP wiring (DNS tooling for this app's domains); not shared.
.mcp.json
