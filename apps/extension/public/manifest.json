{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.1.3",
  "description": "__MSG_description__",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://auth.opencapture.app/*",
    "https://gateway.openapps.network/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://auth.opencapture.app/v1/auth/oidc/google/callback*",
        "https://auth.opencapture.app/signin*",
        "https://auth.opencapture.app/link*"
      ],
      "js": [
        "openapps-callback.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
