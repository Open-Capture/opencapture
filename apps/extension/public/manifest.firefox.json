{
  "manifest_version": 3,
  "name": "OpenCapture \u2014 Private Full-Page Screenshot",
  "version": "0.1.2",
  "description": "100% local full-page screenshots. No cloud upload. All core features free; the watermark tool is a paid Supporter feature.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://auth.opencapture.app/*",
    "https://gateway.openapps.network/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://auth.opencapture.app/v1/auth/oidc/google/callback*",
        "https://auth.opencapture.app/signin*",
        "https://auth.opencapture.app/link*"
      ],
      "js": [
        "openapps-callback.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opencapture@openapps.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
